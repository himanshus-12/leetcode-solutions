class Solution {
public:
    int majorityElement(vector<int>& nums) {

        int a = nums[0];
        int count = 1;
        int n = nums.size();

        for(int i =1; i<n; i++){
            
            if(count == 0){
                a = nums[i];
            }

            if(nums[i] == a){
                count++;
            }
            else{
                count--;
            }
        }
        
        return a;

    }
};
