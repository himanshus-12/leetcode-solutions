class Solution {
public:
    vector<int> searchRange(vector<int>& nums, int target) {

        

        //first occurance
        int st=0, end =nums.size()-1;

        int firstOccr =-1, lastOccr =-1;

        while(st<=end){

            int mid = st + (end-st)/2;

            if(nums[mid] == target) {
                firstOccr = mid;
                end = mid - 1;
            }
            else if(nums[mid] < target) {
                st = mid + 1;
            }
            else {
                end = mid - 1;
            }
            
        }

        //reinitialise them before second loop
        
        st=0, end =nums.size()-1;

        //last occurance 

        while(st<=end){

            int mid = st + (end-st)/2;

            if(nums[mid] == target) {
                lastOccr = mid;
                st = mid + 1;
            }
            else if(nums[mid] < target) {
                st = mid + 1;
            }
            else {
                end = mid - 1;
            }
            
        }

        vector<int> ans;
        ans.push_back(firstOccr);
        ans.push_back(lastOccr);


        return ans;
    }
};
