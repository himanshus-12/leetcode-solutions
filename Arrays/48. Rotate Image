class Solution {
public:

    void reverseRow(vector<vector<int>>& mat, int row) {
        
        int st = 0, end = mat[0].size() - 1;

        while(st < end) {
            swap(mat[row][st], mat[row][end]);
            st++;
            end--;
        }
    }

    void rotate(vector<vector<int>>& mat) {

        int n = mat.size();

        //Transpose matrix
        for(int i = 0; i < n; i++) {

            for(int j = i + 1; j < n; j++) {

                swap(mat[i][j], mat[j][i]);
            }
            
        }

        // Reverse rows
        for(int i = 0; i < n; i++) {

            reverseRow(mat, i);
        }

    }
};
