class Solution {
public:

    void setRow(int row, vector<vector<int>>& matrix) {

        for(int j = 0; j < matrix[0].size(); j++) {
            matrix[row][j] = 0;
        }
    }

    void setCol(int col, vector<vector<int>>& matrix) {

        for(int i = 0; i < matrix.size(); i++) {
            matrix[i][col] = 0;
        }
    }

    void setZeroes(vector<vector<int>>& matrix) {

        int m = matrix.size(), n= matrix[0].size();

        vector<int> rows, cols;

        //store coordinates of original zeroes
        for(int i = 0; i < m; i++) {
            for(int j = 0; j < n; j++) {
                if(matrix[i][j] == 0) {
                    rows.push_back(i);
                    cols.push_back(j);
                }
            }
        }

        //make corresponding rows and columns zero
        for(int i = 0; i < rows.size(); i++) {

            setRow(rows[i], matrix);
            setCol(cols[i], matrix);
            
        }
    }
};
