class Solution {
public:
    bool checkString(string s) {
        
        int count = 0;

        for(int i = 0; i < s.length(); i++) {
            
            if(s[i] == 'b') {
                count++;
            }
            else if(s[i] == 'a' && count > 0) {
                return false;
            }
        }

        return true;
    }
};


/* we check for b and increase count of b
after that at any point of time in rest part of the string if we find 'a' and count of b is greater than 0
we break and return false */
